# Discord bot: required
NODE_ENV=production
DISCORD_TOKEN=
TARGET_CHANNEL_ID=

# Make it a Quote source bot/channel settings
QUOTE_BOT_ID=949479338275913799
QUOTE_BOT_NAME=Make it a Quote
# Comma-separated channel IDs. Leave empty to watch all readable guild channels.
SOURCE_CHANNEL_IDS=

# AI provider. Use an API-key provider on a headless Oracle VM.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional AI limits and access settings
AI_SETTINGS_ALLOWED_USER_IDS=
GEMINI_SOFT_RPM=8
GEMINI_FALLBACK_MINUTES=15
DEBUG_BOT_MESSAGES=0

# Optional Cloudflare image generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional community economy API. Leave ECONOMY_API_SECRET empty unless the
# separate Activity server needs to call the bot's local economy API.
ECONOMY_API_SECRET=
ECONOMY_API_PORT=3099

# Optional scheduled image posts
KITA_IMAGE_INTERVAL_HOURS=

# Optional Spotify history. For Oracle, use a public HTTPS callback URI and
# register the exact same URI in the Spotify Developer Dashboard.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://bot.example.com/spotify/callback
# SPOTIFY_CALLBACK_HOST=127.0.0.1
# SPOTIFY_CALLBACK_PORT=8787
# SPOTIFY_TOKEN_PATH=/home/ubuntu/PDA-Discord-bot/spotify-tokens.json
