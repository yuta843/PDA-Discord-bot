[Unit]
Description=MIQ Discord bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/PDA-Discord-bot
Environment=NODE_ENV=production
Environment=HOME=/home/ubuntu
EnvironmentFile=/home/ubuntu/PDA-Discord-bot/.env

# The default Oracle Ubuntu Node.js installation uses /usr/bin/node.
# If `command -v node` returns another path, replace /usr/bin/node accordingly.
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
