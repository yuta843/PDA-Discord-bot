DISCORD_TOKEN=your_discord_bot_token
TARGET_CHANNEL_ID=123456789012345678

# Make it a Quote's bot ID. This is the current public bot ID; change it if needed.
QUOTE_BOT_ID=949479338275913799
QUOTE_BOT_NAME=Make it a Quote

# Optional: comma-separated source channel IDs. Leave empty to watch every channel
# where this relay bot can read messages.
SOURCE_CHANNEL_IDS=

# Optional: set to 1 while diagnosing message reception.
DEBUG_BOT_MESSAGES=0

# Create an API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_SOFT_RPM=8
# Optional token limits used by /rate limit. Set these to your Gemini project quota.
GEMINI_SOFT_TPM=
GEMINI_DAILY_REQUEST_LIMIT=500
GEMINI_DAILY_TOKEN_LIMIT=
GEMINI_FALLBACK_MINUTES=15

# Create an API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# React to one random recent user message every two minutes.
AUTO_REACTION_ENABLED=true
AUTO_REACTION_INTERVAL_SECONDS=120
AUTO_REACTION_ACTIVITY_WINDOW_SECONDS=60
AUTO_REACTION_MIN_ACTIVITY=5
AUTO_REACTION_BATCH_SIZE=3
AUTO_REACTION_EMOJIS=👍,😂,😮,🤔,🔥

# Stop the bot and suspend Windows at this local time every day.
SYSTEM_SLEEP_ENABLED=false
SYSTEM_SLEEP_TIME=01:00
