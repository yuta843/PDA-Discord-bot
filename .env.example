# Shared server/client settings
NODE_ENV=development
SERVER_PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/pachinko.sqlite
ECONOMY_API_URL=http://127.0.0.1:3099
ECONOMY_API_PORT=3099
ECONOMY_API_SECRET=replace-with-the-same-random-secret-at-least-32-characters
ACTIVITY_SERVER_URL=http://127.0.0.1:3001
ACTIVITY_INSTANCE_ID=
ACTIVITY_BOT_API_SECRET=replace-with-the-same-random-secret-at-least-32-characters

# Optional local media task tools. Leave blank when ffmpeg/ffprobe are on PATH.
FFMPEG_BIN=
FFPROBE_BIN=
MEDIA_TASK_TEMP_DIR=

# Discord OAuth / Activity
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://127.0.0.1
# Optional. When set, the server checks that instanceId is a live Activity instance.
DISCORD_BOT_TOKEN=
SESSION_SECRET=replace_with_at_least_32_random_characters
DEV_AUTH_ENABLED=false

# Vite-exposed values are public; never put secrets behind VITE_.
VITE_DISCORD_CLIENT_ID=your_discord_application_id
VITE_DEV_MODE=false
VITE_ACTIVITY_INSTANCE_ID=
VITE_DEV_GUILD_ID=

# Optional X account verification for Discord server members.
# GitHub Pages can host the landing page, but the callback must reach the Bot backend.
X_VERIFICATION_CLIENT_ID=
X_VERIFICATION_CLIENT_SECRET=
X_VERIFICATION_REDIRECT_URI=https://auth.example.com/x/callback
X_VERIFICATION_GUILD_ID=
X_VERIFICATION_ROLE_ID=
X_VERIFICATION_NOTIFICATION_CHANNEL_ID=
X_VERIFICATION_GUIDE_CHANNEL_ID=
X_VERIFICATION_DATA_PATH=./x-verification-data.json
X_VERIFICATION_CALLBACK_HOST=127.0.0.1
X_VERIFICATION_CALLBACK_PORT=8788
